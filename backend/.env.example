# ==============================================================================
# CampusConnect Backend Environment Configuration
# ==============================================================================
# 1. Duplicate this file and rename it to ".env" inside the backend/ folder.
# 2. Paste your Supabase Session Pooler URI into DATABASE_URL below.
# 3. Paste your Supabase Project URL, Anon Key, and Service Role Key from:
#    Supabase Dashboard -> Project Settings -> API / API Keys
# ==============================================================================

PORT=4000
NODE_ENV=development

# Supabase PostgreSQL Session Pooler URI (IPv4-safe, supports full ACID transactions)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase Auth configuration (Project Settings -> API / API Keys)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Supabase Cloud Storage (server-side ONLY — NEVER put in frontend .env!)
# Create a public bucket named "resource-images" in Supabase -> Storage
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY
SUPABASE_STORAGE_BUCKET=resource-images

# Email Domain Whitelist:
# - Use "*" (or "gmail.com,mit.edu") during testing so personal Gmail accounts work
# - Change to your university domain (e.g. "mitwpu.edu.in") for campus production
ALLOWED_EMAIL_DOMAINS=*

# Dev toggle: allows 1-click demo header login alongside real Bearer JWTs
# Set to "false" in production to enforce strict Supabase JWT authentication only
ENABLE_DEMO_AUTH=true

# Allowed frontend origin for CORS
CORS_ORIGIN=http://localhost:5173
